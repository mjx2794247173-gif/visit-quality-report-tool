DEEPSEEK_API_KEY=在这里填写你的DeepSeek_API_Key
DEEPSEEK_MODEL=deepseek-flash
PORT=8787

# Optional: official Feishu OpenAPI MCP message publishing.
# Create a Feishu app, enable bot/message permission, add the bot to the target group,
# then set the group chat_id below. Never commit the real secret or chat_id.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_RECEIVE_ID=
FEISHU_RECEIVE_ID_TYPE=chat_id
FEISHU_TOKEN_MODE=tenant_access_token
FEISHU_MCP_PACKAGE=@larksuiteoapi/lark-mcp@0.5.1
